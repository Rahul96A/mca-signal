# ─── Data mode ────────────────────────────────────────────────────────────────
# auto  = live providers if any provider key below is set, otherwise demo data
# demo  = always use the bundled fictional demo dataset
# live  = never seed demo data; only use configured providers
DATA_MODE=auto

# ─── Official Government data: Open Government Data Platform (data.gov.in) ─────
# Free key: register at https://data.gov.in → My Account → API key.
# Resource used: "Registrars of Companies (RoC)-wise Company Master Data"
DATA_GOV_API_KEY=
DATA_GOV_COMPANY_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a
# Comma separated state codes (as used in the dataset, e.g. "haryana,karnataka") for the bulk sync worker
DATA_GOV_SYNC_STATES=
DATA_GOV_PAGE_SIZE=500

# ─── Third-party MCA data API (licensed aggregator) ───────────────────────────
# MCA_PROVIDER:
#   "probe42" — Probe42 V1 API: financial statements, directors, charges, name history
#               (MCA_PROVIDER_API_KEY = Probe42 x-api-key; PROBE42_ENV=sandbox|production)
#   "attestr" — Attestr corpx API: directors, charges, e-filings, fuzzy name search
#               (MCA_PROVIDER_API_KEY = Attestr auth token; base URL defaults to https://api.attestr.com)
#   "sandbox" — Sandbox.co.in company master data only
#   "generic" — any API implementing the contract in docs/PROVIDERS.md (can include financials)
MCA_PROVIDER=generic
MCA_PROVIDER_BASE_URL=
MCA_PROVIDER_API_KEY=
MCA_PROVIDER_API_SECRET=
PROBE42_ENV=sandbox

# ─── Database / cache ─────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PGlite (Postgres-in-WASM) database stored in PGLITE_DATA_DIR
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
# Leave empty to use the in-process memory cache
REDIS_URL=
CACHE_TTL_SECONDS=900
# How old a live record may be before it is re-fetched from the provider
ENTITY_STALE_HOURS=24

# ─── AI report (optional; rule-based report is used when empty) ────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Protects POST /api/admin/sync (send as "Authorization: Bearer <token>")
ADMIN_TOKEN=

# ─── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
API_RATE_LIMIT_PER_MINUTE=120
